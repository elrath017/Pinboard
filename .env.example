# Pinboard - Firebase Authentication & Multi-Tenant Firestore Environment Variables
# For Netlify: Add these in Netlify Dashboard under Site Configuration > Environment variables

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-pinboard-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-pinboard-app
VITE_FIREBASE_STORAGE_BUCKET=your-pinboard-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
